# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. http://localhost:3000)
APP_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials (Configured on server, never exposed in client code)
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Session Secret
SESSION_SECRET="khetix_production_secure_session_secret_2026_ind"
